rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function memberPath(uid) {
      return /databases/$(database)/documents/members/$(uid);
    }

    function memberRevocationPath(uid) {
      return /databases/$(database)/documents/memberRevocations/$(uid);
    }

    function isMember() {
      return signedIn()
        && !exists(memberRevocationPath(request.auth.uid))
        && exists(memberPath(request.auth.uid))
        && get(memberPath(request.auth.uid)).data.get('enabled', false) == true
        && get(memberPath(request.auth.uid)).data.get('email', '') == request.auth.token.email
        && get(memberPath(request.auth.uid)).data.get('fullName', '') is string
        && get(memberPath(request.auth.uid)).data.fullName.size() > 0
        && get(memberPath(request.auth.uid)).data.fullName.size() <= 120;
    }

    function eventExists(eventId) {
      return exists(/databases/$(database)/documents/events/$(eventId));
    }

    function queueRevisionAdvanced(eventId) {
      let eventPath = /databases/$(database)/documents/events/$(eventId);
      let revisionBefore = get(eventPath).data.get('queueRevision', -1);
      let revisionAfter = getAfter(eventPath).data.get('queueRevision', -1);
      return revisionBefore is int && revisionAfter == revisionBefore + 1;
    }

    function validDuration(value) {
      return value is string
        && value.size() >= 4
        && value.size() <= 8
        && value.matches('^([0-9]{1,3}:[0-5][0-9]|(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]|24:00:00)$')
        && !(value in ['0:00', '00:00', '000:00', '00:00:00']);
    }

    function validColor(value) {
      return value is string && value.matches('^#[0-9a-fA-F]{6}$');
    }

    function validTimeline(value) {
      return value is map
        && value.keys().hasOnly(['status', 'itemId', 'positionMs', 'anchorAt', 'firstStartedAt', 'commandRevision', 'updatedAt', 'updatedBy'])
        && value.get('status', '') in ['scheduled', 'playing', 'paused', 'ended']
        && (value.get('itemId', null) == null || value.get('itemId', null) is string)
        && value.get('positionMs', -1) is int
        && value.get('positionMs', -1) >= 0
        && value.get('positionMs', -1) <= 86400000
        && (value.get('anchorAt', null) == null || value.get('anchorAt', null) is timestamp)
        && (value.get('firstStartedAt', null) == null || value.get('firstStartedAt', null) is timestamp)
        && value.get('commandRevision', -1) is int
        && value.get('commandRevision', -1) >= 0
        && value.get('updatedAt', null) == request.time
        && value.get('updatedBy', '') == request.auth.uid;
    }

    match /members/{uid} {
      allow get: if signedIn() && request.auth.uid == uid && !exists(memberRevocationPath(uid));
      allow list: if false;
      allow create: if signedIn()
        && request.auth.uid == uid
        && !exists(memberRevocationPath(uid))
        && request.resource.data.keys().hasOnly(['email', 'fullName', 'enabled'])
        && request.resource.data.keys().hasAll(['email', 'fullName', 'enabled'])
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && request.resource.data.fullName.size() <= 120
        && request.resource.data.enabled == true;
      allow update, delete: if false;
    }

    match /memberRevocations/{uid} {
      allow read, write: if false;
    }

    match /events/{eventId} {
      allow get, list: if isMember();
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['title', 'venue', 'date', 'start', 'startAt', 'queueRevision', 'timeline', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && request.resource.data.get('title', '') is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.get('venue', '') is string
        && request.resource.data.venue.size() <= 120
        && request.resource.data.get('date', '') is string
        && request.resource.data.get('start', '') is string
        && request.resource.data.startAt is timestamp
        && request.resource.data.queueRevision == 0
        && validTimeline(request.resource.data.timeline)
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
      allow update: if isMember()
        && request.resource.data.keys().hasOnly(['title', 'venue', 'date', 'start', 'startAt', 'status', 'currentItemId', 'currentStartedAt', 'currentElapsedSeconds', 'timelinePositionSeconds', 'queueRevision', 'timeline', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && request.resource.data.get('title', '') is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.get('venue', '') is string
        && request.resource.data.venue.size() <= 120
        && request.resource.data.get('date', '') is string
        && request.resource.data.get('start', '') is string
        && request.resource.data.startAt is timestamp
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'venue', 'date', 'start', 'startAt', 'queueRevision', 'timeline', 'updatedAt', 'updatedBy'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['timeline']) || validTimeline(request.resource.data.timeline))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['queueRevision'])
          || (request.resource.data.queueRevision is int && request.resource.data.queueRevision == resource.data.get('queueRevision', 0) + 1));
      allow delete: if false;

      match /items/{itemId} {
        allow read: if isMember() && eventExists(eventId);
        allow create: if isMember()
          && eventExists(eventId)
          && queueRevisionAdvanced(eventId)
          && request.resource.data.keys().hasOnly(['title', 'performer', 'description', 'duration', 'type', 'order', 'color', 'createdAt'])
          && request.resource.data.get('title', '') is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 120
          && request.resource.data.get('performer', '') is string
          && request.resource.data.performer.size() <= 120
          && request.resource.data.get('description', '') is string
          && request.resource.data.description.size() <= 800
          && request.resource.data.get('duration', '') is string
          && validDuration(request.resource.data.duration)
          && request.resource.data.get('type', '') in ['performance', 'scene-change', 'Etteaste', 'Üleminek', 'Lava vahetus']
          && request.resource.data.order is int
          && request.resource.data.order >= 0
          && request.resource.data.order <= 399
          && validColor(request.resource.data.get('color', '#59616c'))
          && request.resource.data.createdAt == request.time;
        allow update: if isMember()
          && eventExists(eventId)
          && queueRevisionAdvanced(eventId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'performer', 'description', 'duration', 'type', 'order', 'color'])
          && request.resource.data.get('title', '') is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 120
          && request.resource.data.get('performer', '') is string
          && request.resource.data.performer.size() <= 120
          && request.resource.data.get('description', '') is string
          && request.resource.data.description.size() <= 800
          && request.resource.data.get('duration', '') is string
          && validDuration(request.resource.data.duration)
          && request.resource.data.get('type', '') in ['performance', 'scene-change', 'Etteaste', 'Üleminek', 'Lava vahetus']
          && request.resource.data.order is int
          && request.resource.data.order >= 0
          && request.resource.data.order <= 399
          && validColor(request.resource.data.get('color', '#59616c'));
        allow delete: if isMember() && eventExists(eventId) && queueRevisionAdvanced(eventId);

        match /notes/{noteId} {
          allow read: if isMember()
            && eventExists(eventId)
            && (resource.data.get('department', '') in ['ALL', 'HELI', 'VALGUS', 'VIDEO', 'MUU']
              || resource.data.get('audience', '') in ['all', 'sound', 'lighting', 'video']);
          allow create: if isMember()
            && eventExists(eventId)
            && exists(/databases/$(database)/documents/events/$(eventId)/items/$(itemId))
            && request.resource.data.keys().hasOnly(['body', 'department', 'authorId', 'author', 'updatedAt'])
            && request.resource.data.get('body', '') is string
            && request.resource.data.body.size() > 0
            && request.resource.data.body.size() <= 800
            && request.resource.data.get('department', '') in ['ALL', 'HELI', 'VALGUS', 'VIDEO', 'MUU']
            && request.resource.data.authorId == request.auth.uid
            && request.resource.data.author == get(memberPath(request.auth.uid)).data.fullName
            && request.resource.data.updatedAt == request.time;
          allow update: if isMember()
            && eventExists(eventId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body', 'department', 'updatedAt'])
            && request.resource.data.get('body', '') is string
            && request.resource.data.body.size() > 0
            && request.resource.data.body.size() <= 800
            && request.resource.data.get('department', '') in ['ALL', 'HELI', 'VALGUS', 'VIDEO', 'MUU']
            && request.resource.data.get('authorId', '') == resource.data.get('authorId', '')
            && request.resource.data.get('author', '') == resource.data.get('author', '')
            && request.resource.data.updatedAt == request.time;
          allow delete: if isMember() && eventExists(eventId);
        }
      }

      match /messages/{messageId} {
        allow read: if isMember() && eventExists(eventId) && resource.data.get('audience', 'all') == 'all';
        allow create: if isMember()
          && eventExists(eventId)
          && request.resource.data.keys().hasOnly(['body', 'audience', 'author', 'authorId', 'createdAt', 'important'])
          && request.resource.data.get('body', '') is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 1200
          && request.resource.data.get('audience', '') == 'all'
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.author == get(memberPath(request.auth.uid)).data.fullName
          && request.resource.data.get('important', false) is bool
          && request.resource.data.createdAt == request.time;
        allow update: if isMember()
          && resource.data.authorId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body'])
          && request.resource.data.get('body', '') is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 1200;
        allow delete: if isMember() && resource.data.authorId == request.auth.uid;
      }
    }

    match /users/{uid} { allow read, write: if false; }
    match /settings/{settingId} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
